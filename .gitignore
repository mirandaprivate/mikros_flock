/target
**/target/
**/__pycache__/
/rustc-ice-*.txt
/latex

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Emacs autosave files
\#*\#
.\#*

# LaTeX build output
*.log
!/e2e_flock_sha256.log
!/e2e_flock_keccak.log
!/e2e_flock_blake3.log
!/compare_hadamard_2_30.log
!/single_hash_compare.log
!/single_hash_compare_1thread.log
*.aux
*.out
texput.*

# External checkouts (for benchmarking comparisons)
# benchmarks/setup.sh (top-level orchestrator) is trackable by default;
# the two cloned repos are ignored except their own setup.sh.
benchmarks/plonky3/*
!benchmarks/plonky3/setup.sh
benchmarks/binius64/*
!benchmarks/binius64/setup.sh
!benchmarks/binius64/keccak_permutations.rs
!benchmarks/binius64/sha256_compressions.rs
!benchmarks/binius64/blake3_compressions.rs
!benchmarks/binius64/parallel_witness_gen.patch
benchmarks/bench-hash-in-snark/*
!benchmarks/bench-hash-in-snark/setup.sh
benchmarks/spartan2/*
!benchmarks/spartan2/setup.sh
!benchmarks/spartan2/neutronnova_nn_bytes.patch
!benchmarks/spartan2/spartan_sp_bytes.patch

# bench_keccak.sh / bench_sha256.sh / bench_blake3.sh result caches (machine-specific timings)
benchmarks/bench-keccak-cache/
benchmarks/bench-sha256-cache/
benchmarks/bench-blake3-cache/

benchmarks/cache/

# Local development tools
.claude/
.codex/
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
CONTEXT.md
CONTEXT-MAP.md

# LaTeX SyncTeX artifacts, including the transient *.synctex(busy) written
# mid-compile (the bare *.synctex.gz rules above don't cover it).
*.synctex
*.synctex.gz
*.synctex(busy)

# Autoresearch loop artifacts (results TSVs, verify scripts, raw bench logs)
autoresearch/

# Local working notes (review docs, scratch write-ups) — not part of the project
docs/local/

# Built design-doc PDFs (source .tex files are tracked; PDFs are build output)
docs/*.pdf
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# cuda-ghash — GPU/CUDA port build artifacts (sources are tracked).
# Compiled test/bench executables have no extension; the generated bit-for-bit
# oracle vectors (*.bin) are large and regenerated by the Rust dump_* bins.
/cuda-ghash/*.bin
/cuda-ghash/*.cubin
# Compiled binaries (extensionless) emitted by the Makefile targets:
/cuda-ghash/test_*
/cuda-ghash/bench_*
/cuda-ghash/probe
/cuda-ghash/host_check_ntt
/cuda-ghash/clmad_ilp
/cuda-ghash/clmad_peak
/cuda-ghash/ghash_ilp
# ...but keep their source and any Markdown/headers:
!/cuda-ghash/test_*.cu
!/cuda-ghash/test_*.cpp
!/cuda-ghash/bench_*.cu

# Local checkpoints
/agents/

